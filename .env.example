# AI Keys (used by mock-server.js for grounded AI responses)
# Get your Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get your OpenAI key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Custom JWT secret for auth token signing (change this for production)
JWT_SECRET=your_custom_jwt_secret_here
